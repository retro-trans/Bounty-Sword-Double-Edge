 },
 {
  "id": "S105_0026",
  "off": 1580,
  "end": 1672,
  "block": 6,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"You seem to hate me, but that very{n} fluctuation of emotion is, in the end,{n} the limit of the creature called human.\"",
  "src": "ddfb19dc37f4"
 },
 {
  "id": "S105_0027",
  "off": 1674,
  "end": 1768,
  "block": 6,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Runaway thought, runaway emotion.{n} Attach a rationale to them, and at{n} once they become a righteous war.\"",
  "src": "8832a3a7acae"
 },
 {
  "id": "S105_0028",
  "off": 1770,
  "end": 1802,
  "block": 6,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Dogs and cats are wiser than you.\"",
  "src": "87b0d6fa28f5"
 },
 {
  "id": "S105_0029",
  "off": 1804,
  "end": 1870,
  "block": 6,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"They are faithful to their own{n} instincts, and so they never{n} act beyond them.\"",
  "src": "977946c25aed"
 },
 {
  "id": "S105_0030",
  "off": 1872,
  "end": 1928,
  "block": 6,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"What humans do is always beyond{n} their station. Do you not think so?\"",
  "src": "f8df715f74ec"
 },
 {
  "id": "S105_0031",
  "off": 1940,
  "end": 2044,
  "block": 7,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"No creature in this world but humans{n} kills itself over a fluctuation of{n} emotion. By any measure, a foolish act.\"",
  "src": "8b779c393931"
 },
 {
  "id": "S105_0032",
  "off": 2046,
  "end": 2140,
  "block": 7,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Other creatures control their total{n} numbers through group consciousness{n} alone. But that means something else.\"",
  "src": "ac57347e7757"
 },
 {
  "id": "S105_0033",
  "off": 2142,
  "end": 2178,
  "block": 7,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"You call it suicide, I believe.\"",
  "src": "b62c4556411d"
 },
 {
  "id": "S105_0034",
  "off": 2180,
  "end": 2278,
  "block": 7,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Come to think of it, the one who was{n} your father also performed self-killing,{n} I believe. Was that not so, {hero:6}?\"",
  "src": "1f4732af9ed7"
 },
 {
  "id": "S105_0035",
  "off": 2280,
  "end": 2390,
  "block": 7,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"A foolish form of life, humans. And{n} a foolish specimen, your father.{n} You carry on those genes...\"",
  "src": "be870b75604e"
 },
 {
  "id": "S105_0036",
  "off": 2392,
  "end": 2424,
  "block": 7,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Are you, too, a foolish being?\"",
  "src": "0e45d05de3bb"
 },
 {
  "id": "S105_0037",
  "off": 2434,
  "end": 2448,
  "block": 7,
  "bank": "scene",
  "spk": "8061:1,0,0",
  "kind": "dlg",
  "en": "\"You bastard...\"",
  "src": "3fb626130f1e"
 },
 {
  "id": "S105_0038",
  "off": 2460,
  "end": 2556,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Your spouse was brutally murdered by{n} humans of the same group, I believe.{n} Was that not so, {name:6}?\"",
  "src": "2148942ae210"
 },
 {
  "id": "S105_0039",
  "off": 2566,
  "end": 2590,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2,0,0",
  "kind": "dlg",
  "en": "\"How do you know that...?\"",
  "src": "d493c314b250"
 },
 {
  "id": "S105_0040",
  "off": 2600,
  "end": 2696,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Other creatures do not kill their own{n} kind unless driven by need.{n} What is it that you fear most...\"",
  "src": "61180d4a2a00"
 },
 {
  "id": "S105_0041",
  "off": 2698,
  "end": 2724,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Yes. It is the human corpse.\"",
  "src": "835038f01537"
 },
 {
  "id": "S105_0042",
  "off": 2726,
  "end": 2826,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"An instinct carved into your hearts:{n} to fear the death of your own kind and{n} flee it. That is the ethic of right living.\"",
  "src": "22e320395c9f"
 },
 {
  "id": "S105_0043",
  "off": 2828,
  "end": 2858,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"And yet you kill your own kind{n} out of desire.\"",
  "src": "6a7c5fcdb25d"
 },
 {
  "id": "S105_0044",
  "off": 2860,
  "end": 2934,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Your spouse wished to set that right.{n} That is why he went to battle{n} of his own accord, I believe.\"",
  "src": "01b02cfe3bf6"
 },
 {
  "id": "S105_0045",
  "off": 2936,
  "end": 2970,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"However, deep in his subconscious...\"",
  "src": "d27829435e9d"
 },
 {
  "id": "S105_0046",
  "off": 2972,
  "end": 3060,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"He must have thought himself, for{n} thinking so, a noble human,{n} different from the other humans.\"",
  "src": "9fd8011cf224"
 },
 {
  "id": "S105_0047",
  "off": 3062,
  "end": 3150,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"This, too, is beyond one's station.{n} For he, too, was one of the kind{n} that kills its own kind.\"",
  "src": "29ac914fc3d1"
 },
 {
  "id": "S105_0048",
  "off": 3160,
  "end": 3216,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2,0,0",
  "kind": "dlg",
  "en": "\"That's not true! Hector isn't{n} that kind of person!\"",
  "src": "305c1e20cd1e"
 },
 {
  "id": "S105_0049",
  "off": 3226,
  "end": 3330,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"You, too, must be drunk on the image{n} of yourself carrying on your spouse's{n} will. A shackle called futile duty.\"",
  "src": "5f3196c76d27"
 },
 {
  "id": "S105_0050",
  "off": 3332,
  "end": 3398,
  "block": 8,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"In that shackle you found pleasure.{n} You attached a rationale{n} for your own living.\"",
  "src": "6eb00969cb2e"
 },
 {
  "id": "S105_0051",
  "off": 3404,
  "end": 3442,
  "block": 8,
  "bank": "scene",
  "spk": "8033:2",
  "kind": "dlg",
  "en": "\"You're wrong! You're wrong! You're wrong!\"",
  "src": "b8bd5adab4b3"
 },
 {
  "id": "S105_0052",
  "off": 3452,
  "end": 3478,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"You hate me more and more.\"",
  "src": "0def83b0afd6"
 },
 {
  "id": "S105_0053",
  "off": 3480,
  "end": 3572,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"It is a compound element of emotional{n} fluctuation. Wishing to eliminate it,{n} I made what you call Machine Soldiers.\"",
  "src": "b7956c36c57a"
 },
 {
  "id": "S105_0054",
  "off": 3574,
  "end": 3602,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"But those, too, were failures.\"",
  "src": "95971fdac300"
 },
 {
  "id": "S105_0055",
  "off": 3604,
  "end": 3624,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"They went too far to both extremes.\"",
  "src": "5e275999f4ec"
 },
 {
  "id": "S105_0056",
  "off": 3626,
  "end": 3714,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Units that obey only the set rules,{n} or units that, through damage, came to{n} have the same fluctuation as humans.\"",
  "src": "c1e92f7e130f"
 },
 {
  "id": "S105_0057",
  "off": 3716,
  "end": 3814,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Because I gave them a half-measure of{n} ethical reasoning beyond that of{n} humans, they too were deemed failures.\"",
  "src": "e39f587445b5"
 },
 {
  "id": "S105_0058",
  "off": 3816,
  "end": 3922,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"Taken as a whole, you humans at times{n} show power beyond your specifications,{n} so some held that you were a success...\"",
  "src": "5bb4356adc60"
 },
 {
  "id": "S105_0059",
  "off": 3924,
  "end": 3950,
  "block": 9,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"But that, too, seems doubtful.\"",
  "src": "6141badfe67d"
 },
 {
  "id": "S105_0060",
