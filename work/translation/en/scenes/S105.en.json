  "end": 4018,
  "block": 10,
  "bank": "scene",
  "spk": "8061:1,0,0",
  "kind": "dlg",
  "en": "\"An experiment...?\"",
  "src": "18fc31cfd1e3"
 },
 {
  "id": "S105_0062",
  "off": 4028,
  "end": 4046,
  "block": 11,
  "bank": "scene",
  "spk": "8061:2,0,0",
  "kind": "dlg",
  "en": "\"An experiment, you say?\"",
  "src": "73eb9595fa9c"
 },
 {
  "id": "S105_0063",
  "off": 4056,
  "end": 4160,
  "block": 12,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"So far I have made several Machine Men{n} as prototype vessels for the soul,{n} but these, too, are developing faults.\"",
  "src": "15e97e05ed1c"
 },
 {
  "id": "S105_0064",
  "off": 4162,
  "end": 4174,
  "block": 12,
  "bank": "scene",
  "spk": "8061:2d,0,0",
  "kind": "dlg",
  "en": "\"That being so,\"",
  "src": "199186f3797d"
 },
 {
  "id": "S105_0065",
