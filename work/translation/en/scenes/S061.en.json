  "off": 8230,
  "end": 8266,
  "block": 15,
  "bank": "scene",
  "spk": "8061:41,0,0",
  "kind": "dlg",
  "en": "\"The last stop for every living{n} thing is death.\"",
  "src": "534e1e0a29fc"
 },
 {
  "id": "S061_0118",
  "off": 8268,
  "end": 8360,
  "block": 15,
  "bank": "scene",
  "spk": "8061:41,0,0",
  "kind": "dlg",
  "en": "\"A life without death is a journey{n} with no destination. And such a journey{n} is like hell's torment, without end.\"",
