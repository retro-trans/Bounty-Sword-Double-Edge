 },
 {
  "id": "S060_0114",
  "off": 7988,
  "end": 8072,
  "block": 15,
  "bank": "scene",
  "spk": "8061:41,0,0",
  "kind": "dlg",
  "en": "\"Long, long ago, when this island of{n} steel teemed with the descendants{n} of the gods and was full of life...\"",
  "src": "f082917a249f"
 },
 {
  "id": "S060_0115",
  "off": 8074,
  "end": 8162,
  "block": 15,
  "bank": "scene",
  "spk": "8061:41,0,0",
  "kind": "dlg",
  "en": "\"In exchange for eternal life,{n} I dropped my freedom to die{n} somewhere along the way...\"",
  "src": "688f36e79758"
 },
 {
  "id": "S060_0116",
  "off": 8172,
  "end": 8188,
  "block": 15,
  "bank": "scene",
  "spk": "8061:1,0,0",
  "kind": "dlg",
  "en": "\"The freedom to die...\"",
