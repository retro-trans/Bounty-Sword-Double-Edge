  "off": 4372,
  "end": 4458,
  "block": 10,
  "bank": "scene",
  "spk": "8024:7",
  "kind": "dlg",
  "en": "\"Well, what do you say?{n} About my request from earlier:{n} will you let me join your party?\"",
