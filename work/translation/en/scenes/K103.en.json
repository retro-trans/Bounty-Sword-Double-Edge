  "off": 4240,
  "end": 4334,
  "block": 14,
  "bank": "scene",
  "spk": "8002:5e",
  "kind": "dlg",
  "en": "\"If they wish hard enough, humans can{n} change into the self they picture.{n} And only humans can do that, too.\"",
  "src": "13467157c817"
 },
 {
  "id": "K103_0066",
  "off": 4340,
  "end": 4352,
  "block": 14,
  "bank": "scene",
  "spk": "8002:1",
  "kind": "dlg",
  "en": "\"Hmph...\"",
  "src": "077caf0c31e9"
 },
 {
