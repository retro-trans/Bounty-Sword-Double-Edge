  "off": 1026,
  "end": 1110,
  "block": 3,
  "bank": "scene",
  "spk": "8002:6",
  "kind": "dlg",
  "en": "\"This is my revenge. It's not for{n} anybody else. It's the start{n} of a revenge that's for me alone.\"",
