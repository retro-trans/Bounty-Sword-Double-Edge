  "off": 1410,
  "end": 1508,
  "block": 5,
  "bank": "scene",
  "spk": "8002:1",
  "kind": "dlg",
  "en": "\"I don't care if you're a bodyguard or{n} what. Get out of the way, now. Or do{n} you want to get killed while I'm at it?\"",
