 },
 {
  "id": "K103_0054",
  "off": 3418,
  "end": 3448,
  "block": 14,
  "bank": "scene",
  "spk": "8002:5e",
  "kind": "dlg",
  "en": "\"Those who kill and those who{n} get killed, hm...\"",
  "src": "d945c31e6066"
 },
 {
  "id": "K103_0055",
  "off": 3450,
  "end": 3548,
  "block": 14,
  "bank": "scene",
  "spk": "8002:5e",
  "kind": "dlg",
  "en": "\"It's true that ever since humans were{n} born on this earth, they've gone on{n} killing each other, though all one kind.\"",
  "src": "c5c2dcedc586"
 },
 {
  "id": "K103_0056",
  "off": 3550,
  "end": 3652,
  "block": 14,
  "bank": "scene",
  "spk": "8002:5e",
  "kind": "dlg",
  "en": "\"At times to satisfy their own desires,{n} at times at the end of hatred,{n} and at times enjoying the killing itself.\"",
  "src": "aafe7ebea781"
 },
 {
  "id": "K103_0057",
  "off": 3654,
  "end": 3722,
  "block": 14,
  "bank": "scene",
  "spk": "8002:5e",
  "kind": "dlg",
  "en": "\"Other living things do no such{n} thing. Do you know why that is?\"",
  "src": "1f642b0cb908"
 },
 {
