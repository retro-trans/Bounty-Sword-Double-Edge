  "off": 3706,
  "end": 3768,
  "block": 18,
  "bank": "scene",
  "spk": "8002:2",
  "kind": "dlg",
  "en": "\"The answer is... that there is{n} no true answer anywhere.\"",
  "src": "987a2f65e56c"
 },
 {
  "id": "S111_0074",
  "off": 3770,
  "end": 3834,
  "block": 18,
  "bank": "scene",
  "spk": "8002:2",
  "kind": "dlg",
  "en": "\"What sets people apart from animals,{n} at the root, is that they think about{n} the meaning of things.\"",
  "src": "c876ad7b5446"
 },
 {
  "id": "S111_0075",
  "off": 3836,
  "end": 3936,
  "block": 18,
  "bank": "scene",
  "spk": "8002:2",
  "kind": "dlg",
  "en": "\"Why do things like this happen?{n} People kept pondering the meaning{n} of things, and created science and math.\"",
  "src": "42aab57382a1"
 },
 {
  "id": "S111_0076",
  "off": 3938,
  "end": 4030,
  "block": 18,
  "bank": "scene",
  "spk": "8002:2",
  "kind": "dlg",
  "en": "\"But if you think hard, you'll see.{n} Do people really need meaning{n} in order to live?\"",
