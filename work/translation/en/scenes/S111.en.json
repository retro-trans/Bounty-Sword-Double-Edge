  "off": 4354,
  "end": 4458,
  "block": 19,
  "bank": "scene",
  "spk": "8002:2",
  "kind": "dlg",
  "en": "\"It's the same as birds flying in the sky,{n} the same as fish swimming in the water.{n} It's the fate humans are born with.\"",
