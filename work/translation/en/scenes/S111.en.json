 },
 {
  "id": "S111_0077",
  "off": 4032,
  "end": 4138,
  "block": 18,
  "bank": "scene",
  "spk": "8002:2",
  "kind": "dlg",
  "en": "\"When birds fly through the sky, when{n} fish swim in the sea, none of them ponder{n} its meaning or study how to fly...\"",
